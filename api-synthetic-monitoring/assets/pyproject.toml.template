[project]
name = "<service>-api-monitor"
version = "0.1.0"
requires-python = ">=3.10"
dependencies = [
    "requests>=2.31",
    "pytest>=8.0",
    "pytest-reportportal>=5.4",
]

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
# If you have both `lib/` and `checks/` at package root, enumerate them
# explicitly — setuptools' auto-discovery rejects multi-top-level layouts.
include = ["config", "envs", "lib", "checks"]

[tool.pytest.ini_options]
testpaths = ["checks"]
