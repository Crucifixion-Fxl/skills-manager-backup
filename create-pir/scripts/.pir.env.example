# create-pir Skill 的配置文件模板
#
# ⚠️  配置文件放哪里？（重要）
#
#   推荐：用 --init-profile 对话式创建
#   python create_pir_event.py --init-profile my-vh
#   → 会自动存到 ~/.config/addx/pir/my-vh.env（chmod 600）
#   → 使用：python create_pir_event.py --profile my-vh
#
#   手动方式：复制本文件为：
#     ✅  ~/.config/addx/pir/<name>.env   （推荐，profile 形式）
#     ✅  ~/.config/addx/pir.env           （单文件，全局）
#     ❌  skill 目录下的 .pir.env          （NEVER：plugin install 会把它复制给其他同事，泄露凭证！）
#
#   本文件位于 skill 内，仅作为参考模板，不要在此填真实密码。
#
# ─── 必填 ───
PIR_BRAND=vicohome            # vicohome | kiwibit | viconature
PIR_REGION=us                 # us | eu（kiwibit / viconature 只有 us）
PIR_ENV=prod                  # staging | pre | prod
PIR_EMAIL=                    # 测试账号邮箱
PIR_PASSWORD=                 # 测试账号密码
PIR_DEVICE=                   # 设备 serialNumber（绑在上述账号下且支持 PIR）
PIR_USER_SN=                  # 账号 userSn
PIR_SIGN_SECRET=              # 设备签名密钥 (base64)，从 MeterSphere 场景「[自动化] PIR 事件」提取

# ─── 可选：域名覆盖 ───
# 仅在脚本 preset 不匹配当前场景时手动设置
# PIR_BUSINESS_API=https://api-us.vicohome.io
# PIR_DEVICE_API=https://api-us.vicohome.io

# ─── 可选：staging bird/small_animal AI 地理门禁测试 ───
# 仅 staging 接受；必须是可供 GeoIP 解析的公网 IP
# PIR_AI_LOCATION_IP=
# 可选；仅用于本次 AI 事件，必须配合 PIR_AI_LOCATION_IP（例如 US）
# PIR_AI_COUNTRY_NO=

# ─── 可选：视频/图片占位 URL ───
# PIR_TEST_IMAGE_URL=https://...jpg
# PIR_TEST_VIDEO_URL=https://...ts
