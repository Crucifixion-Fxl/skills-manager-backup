# sla-alert-analysis 凭据模板（非 Claude Code 用户使用）
#
# 使用方法：
#   cp .env.example .env
#   填入下面的真实值
#   .env 已被仓库 .gitignore 排除，不会被提交
#
# Claude Code 用户推荐改用 ~/.claude/password（见 SKILL.md「凭据配置」一节）。

# SLA Metric API token (https://dapp-api.addx.live)
SLA_API_TOKEN=

# Superset 账号密码（飞书 SSO 登录后到 /user_info/ 重置数据库密码）
SUPERSET_USERNAME=
SUPERSET_PASSWORD=

# 可选：覆盖默认 endpoint
# SLA_API_BASE_URL=https://dapp-api.addx.live
# SUPERSET_BASE_URL=https://superset-us.addx.live
