# crossplane-rds-password-generator.yaml.tmpl
#
# ESO Password Generator —— RDS master password A1 链路的第一环。
#
# 配套：
#   - crossplane-rds-password-external-secret.yaml.tmpl  把生成的 password 写到 K8s Secret
#   - crossplane-rds-password-push-secret.yaml.tmpl      把 K8s Secret 推到 Vault platform 路径
# 三个文件 **必须一起** 写到同一个 overlay；缺一个 RDS 起不来。
#
# 必填槽位：
#   {{app}}        kebab-case
#   {{namespace}}  overlay 目标 namespace
#
# 漂移红线（A1 链路很敏感，违反 → AWS RDS 密码被改 → app 读旧密码连不上）：
#   1. 永远不要 kubectl delete secret <app>-rds-password
#   2. 永远不要改 Generator 的 spec 字段（length / digits / symbols）
#   3. namespace prune 之前先备份 vault 路径
#   4. 应急 rotate 由运维用 rds-admin-<env> Vault role 走带外操作，不用 Generator

apiVersion: generators.external-secrets.io/v1alpha1
kind: Password
metadata:
  name: {{app}}-rds-password-gen
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "-5"
spec:
  length: 24
  digits: 5
  symbols: 0                # RDS/Aurora 限制 symbol 字符集；最稳是禁用
  symbolCharacters: ""
  noUpper: false
  allowRepeat: true
