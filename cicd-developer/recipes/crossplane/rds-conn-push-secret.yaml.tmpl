# PushSecret — Crossplane RDS connection details into Vault.
#
# Required slots:
#   {{app}}                   kebab-case
#   {{env}}                   dev | staging | pre | prod (matches Vault env)
#   {{namespace}}             same as RDS Instance
#   {{cluster_secret_store}}  target cluster CSS from references/data/clusters.yaml -> vault_css
#
# This PushSecret reads the 7-key Secret <app>-rds-conn that Crossplane writes
# (host / address / port / endpoint / username / password / attribute.password)
# and pushes the 4 fields the app consumes to Vault platform path.
#
# IMPORTANT — fixed conventions:
#   0. remoteKey is relative to ClusterSecretStore path=secret. The canonical
#      Vault path remains secret/{env}/rds/application/{app}/database; do not
#      put the literal secret/ prefix in this writer field.
#   1. updatePolicy MUST be IfNotExists. With Replace + 7 keys + attribute.password
#      property mapped, ESO 1.3.2 wipes Vault on next reconcile.
#   2. Map `host` (not `endpoint`) into DB_HOST. The historical "endpoint with
#      :port" hack is no longer needed — rds.aws.m.upbound.io/v1beta1 emits
#      a clean `host` field. ExternalSecret can directly consume DB_HOST
#      without trimming.
#   3. DO NOT also map `endpoint` into the same Vault path. Two-source writes
#      race.
#   4. If PushSecret stays stuck with `secret key endpoint does not exist`
#      after first sync, the Crossplane Secret was caught mid-write. Fix:
#      `kubectl delete pushsecret {{app}}-rds-push` and let ArgoCD selfHeal
#      rebuild it. Treat each region independently; a one-time manual nudge
#      may be needed per region.

apiVersion: external-secrets.io/v1alpha1
kind: PushSecret
metadata:
  name: {{app}}-rds-push
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "0"
spec:
  refreshInterval: 1m
  updatePolicy: IfNotExists       # REQUIRED — see file header
  secretStoreRefs:
    - name: {{cluster_secret_store}}
      kind: ClusterSecretStore
  selector:
    secret:
      name: {{app}}-rds-conn
  data:
    - match:
        secretKey: host
        remoteRef:
          remoteKey: {{env}}/rds/application/{{app}}/database
          property: DB_HOST
    - match:
        secretKey: port
        remoteRef:
          remoteKey: {{env}}/rds/application/{{app}}/database
          property: DB_PORT
    - match:
        secretKey: username
        remoteRef:
          remoteKey: {{env}}/rds/application/{{app}}/database
          property: DB_USER
    - match:
        secretKey: password
        remoteRef:
          remoteKey: {{env}}/rds/application/{{app}}/database
          property: DB_PASSWORD
