# ninedata-conn-external-secret.yaml.tmpl
#
# ExternalSecret that normalizes DB connection fields into the exact Secret
# schema provider-ninedata expects:
#   host / port / username / password
#
# Required slots:
#   {{db_conn_secret}}        K8s Secret consumed by DataSource, e.g. <app>-ninedata-conn
#   {{namespace}}             app namespace
#   {{cluster_secret_store}}  target cluster CSS from references/data/clusters.yaml -> vault_css
#   {{refresh_interval}}      default 1h
#   {{vault_remote_key}}      ExternalSecret remoteRef.key, e.g.
#                             prod/aurora/application/<app>/cluster
#                             (no `secret/` prefix; CSS already mounts path: secret)
#
# Use this when the raw Crossplane connection Secret is not already in
# NineData's schema. Aurora always needs this normalization; old RDS fleets may
# need it when the source only exposes endpoint instead of host.

apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{db_conn_secret}}
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  refreshInterval: {{refresh_interval}}
  secretStoreRef:
    name: {{cluster_secret_store}}
    kind: ClusterSecretStore
  target:
    name: {{db_conn_secret}}
    creationPolicy: Owner
    template:
      engineVersion: v2
      data:
        host: '{{ regexReplaceAll ":[0-9]+$" .DB_HOST "" }}'
        port: '{{ .DB_PORT }}'
        username: '{{ .DB_USER }}'
        password: '{{ .DB_PASSWORD }}'
  data:
    - secretKey: DB_HOST
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_HOST
    - secretKey: DB_PORT
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_PORT
    - secretKey: DB_USER
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_USER
    - secretKey: DB_PASSWORD
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_PASSWORD
