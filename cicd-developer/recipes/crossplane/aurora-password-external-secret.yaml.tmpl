# aurora-password-external-secret.yaml.tmpl
#
# Second stage of the Aurora A1 password chain. Keep the generated Secret
# independent of the ExternalSecret owner reference and immutable after creation.
# Do not delete/recreate the ExternalSecret to repair a live password chain.
#
# Required slots: {{app}}, {{namespace}}

apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{app}}-aurora-password
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "-4"
spec:
  refreshPolicy: CreatedOnce
  target:
    name: {{app}}-aurora-password
    creationPolicy: Orphan
    deletionPolicy: Retain
    immutable: true
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: {{app}}-aurora-password-gen
