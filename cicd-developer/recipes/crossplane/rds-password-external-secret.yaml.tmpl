# crossplane-rds-password-external-secret.yaml.tmpl
#
# ExternalSecret —— RDS master password A1 链路的第二环。
# 从 Password Generator 取生成的 password，写到 K8s Secret <app>-rds-password。
#
# 配套：见 crossplane-rds-password-generator.yaml.tmpl 头部。
#
# 必填槽位：
#   {{app}}        kebab-case
#   {{namespace}}  overlay 目标 namespace
#
# 关键设计：
#   refreshPolicy: CreatedOnce  首次创建后不因 generator 值变化而轮换
#   creationPolicy: Orphan      Secret 不设置 ES ownerReference，ES 删除时避免 GC 删除密码
#   immutable: true             禁止原地改写已有密码 Secret
#   deletionPolicy: Retain      远端数据消失时保留 Secret；它本身不阻止 ownerReference GC
#   生产排障仍不要删 ES 再重建；先验证 Secret / PushSecret / Vault 链路。

apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{app}}-rds-password
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "-4"
spec:
  refreshPolicy: CreatedOnce
  target:
    name: {{app}}-rds-password
    creationPolicy: Orphan
    deletionPolicy: Retain
    immutable: true
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: {{app}}-rds-password-gen
