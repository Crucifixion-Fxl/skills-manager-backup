# crossplane-rds-password-external-secret.yaml.tmpl
#
# ExternalSecret —— RDS master password A1 链路的第二环。
# 从 Password Generator 取生成的 password，写到 K8s Secret <app>-rds-password。
#
# 配套：见 crossplane-rds-password-generator.yaml.tmpl 头部。
#
# 必填槽位：
#   {{app}}        kebab-case
#   {{namespace}}  overlay 目标 namespace
#
# 关键设计：
#   refreshInterval: 0s          一次性生成；不轮换（轮换由运维带外做）
#   deletionPolicy: Retain       ES 被删时不删 K8s Secret，但不代表删 ES 再重建是安全修复手段。
#                               实测 generator 型 ExternalSecret 重建时可能覆盖现有 Secret。
#                               生产排障禁止 delete/recreate；先验证 Secret / PushSecret / Vault 链路。

apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{app}}-rds-password
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "-4"
spec:
  refreshInterval: 0s         # 一次性：Generator 跑一次 -> ES 写 Secret -> 之后不再轮换
  target:
    name: {{app}}-rds-password
    creationPolicy: Owner
    deletionPolicy: Retain     # 只保证 ES 被删时不删 Secret；不要删 ES 再重建，generator 仍可能覆盖现有 Secret
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: {{app}}-rds-password-gen
