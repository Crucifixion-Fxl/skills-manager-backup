# aurora-conn-push-secret.yaml.tmpl
#
# PushSecret -- Crossplane Aurora Cluster connection details into Vault.
#
# Required slots:
#   {{app}}                   kebab-case
#   {{env}}                   dev | staging | pre | prod (matches Vault env)
#   {{namespace}}             same namespace as Aurora Cluster
#   {{cluster_secret_store}}  target cluster CSS from references/data/clusters.yaml -> vault_css
#
# Why this is not rds-conn-push-secret.yaml.tmpl:
#   Aurora Cluster connection keys are not the same as RDS Instance keys.
#   The source cicd-developer text mixes several RDS schema generations; for
#   Aurora, keep the dedicated mapping from the Aurora reference instead of
#   "translating" it through the RDS template.
#
# Expected Aurora source Secret keys:
#   endpoint                  writer endpoint
#   port                      DB port
#   master_username           DB user
#   attribute.master_password DB password
#   reader_endpoint           reader endpoint
#
# If a provider upgrade changes these source key names, STOP and verify the
# actual Secret with:
#   kubectl -n <namespace> get secret <app>-aurora-conn -o jsonpath='{.data}' | jq 'keys'
# Do not guess by copying RDS Instance keys.
#
# The canonical Vault path is secret/{env}/aurora/application/{app}/cluster,
# but remoteKey is relative because ClusterSecretStore already mounts path=secret.

apiVersion: external-secrets.io/v1alpha1
kind: PushSecret
metadata:
  name: {{app}}-aurora-push
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "0"
spec:
  refreshInterval: 1m
  updatePolicy: IfNotExists
  secretStoreRefs:
    - name: {{cluster_secret_store}}
      kind: ClusterSecretStore
  selector:
    secret:
      name: {{app}}-aurora-conn
  data:
    - match:
        secretKey: endpoint
        remoteRef:
          remoteKey: {{env}}/aurora/application/{{app}}/cluster
          property: DB_HOST
    - match:
        secretKey: port
        remoteRef:
          remoteKey: {{env}}/aurora/application/{{app}}/cluster
          property: DB_PORT
    - match:
        secretKey: master_username
        remoteRef:
          remoteKey: {{env}}/aurora/application/{{app}}/cluster
          property: DB_USER
    - match:
        secretKey: attribute.master_password
        remoteRef:
          remoteKey: {{env}}/aurora/application/{{app}}/cluster
          property: DB_PASSWORD
    - match:
        secretKey: reader_endpoint
        remoteRef:
          remoteKey: {{env}}/aurora/application/{{app}}/cluster
          property: DB_READER_HOST
