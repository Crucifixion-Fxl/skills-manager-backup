# crossplane-rds-password-push-secret.yaml.tmpl
#
# PushSecret —— RDS master password A1 链路的第三环。
# 把 K8s Secret <app>-rds-password 推到 Vault platform 路径
#   secret/{env}/rds/application/<app>/master-password
# ClusterSecretStore 已挂 path=secret，所以 remoteKey 必须写相对路径
#   {env}/rds/application/<app>/master-password
#
# 配套：见 crossplane-rds-password-generator.yaml.tmpl 头部。
#
# 必填槽位：
#   {{app}}                    kebab-case
#   {{env}}                    dev | staging | pre | prod（vault 路径用）
#   {{namespace}}              overlay 目标 namespace
#   {{cluster_secret_store}}   目标集群 CSS；查 references/data/clusters.yaml -> vault_css
#
# 关键设计：
#   updatePolicy: IfNotExists  避免 ESO 1.3.2 Replace + 7-key + attribute.password
#                              触发的数据丢失 bug。代价：rotate 必须运维带外做
#                              （Generator 不能 rotate），RDS 实际 rotate 频率极低可接受。

apiVersion: external-secrets.io/v1alpha1
kind: PushSecret
metadata:
  name: {{app}}-rds-password-push
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
spec:
  refreshInterval: 1m
  updatePolicy: IfNotExists                # 强制：见上方说明
  secretStoreRefs:
    - name: {{cluster_secret_store}}
      kind: ClusterSecretStore
  selector:
    secret:
      name: {{app}}-rds-password
  data:
    - match:
        secretKey: password
        remoteRef:
          remoteKey: {{env}}/rds/application/{{app}}/master-password
          property: password
