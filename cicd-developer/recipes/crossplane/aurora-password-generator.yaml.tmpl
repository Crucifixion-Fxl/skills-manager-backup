# aurora-password-generator.yaml.tmpl
#
# First stage of the Aurora A1 password chain. Keep this separate from the RDS
# variant so a service can safely own both an RDS instance and an Aurora cluster.
#
# Required slots: {{app}}, {{namespace}}

apiVersion: generators.external-secrets.io/v1alpha1
kind: Password
metadata:
  name: {{app}}-aurora-password-gen
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "-5"
spec:
  length: 24
  digits: 5
  symbols: 0
  symbolCharacters: ""
  noUpper: false
  allowRepeat: true
