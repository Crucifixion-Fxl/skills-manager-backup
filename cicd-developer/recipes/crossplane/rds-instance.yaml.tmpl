# Crossplane RDS Instance (v2 namespaced m.upbound.io variant).
#
# Required slots:
#   {{app}}                kebab-case
#   {{env_keyword}}        e.g. staging-us (used in identifier and tags)
#   {{engine}}             postgres | mysql | mariadb
#   {{engine_version}}     pin to a specific minor, e.g. "15" for postgres
#   {{engine_family_fields}} for mysql, exactly two four-space-indented lines from
#                          references/cost-tiering/rds.yaml -> engine_contracts.mysql:
#                            parameterGroupName: default.mysql8.4
#                            optionGroupName: default:mysql-8-4
#                          empty for postgres / mariadb
#   {{db_name}}            initial database name (snake_case; immutable)
#   {{instance_class}}     from references/cost-tiering/rds.yaml -> <env>.instanceClass
#   {{allocated_storage}}  from cost-tiering.yaml
#   {{username}}           DB user name (snake_case allowed, no hyphens)
#   {{multi_az}}            from cost-tiering.yaml (true | false)
#   {{storage_encrypted}}   from cost-tiering.yaml (true | false)
#   {{deletion_protection}} from cost-tiering.yaml (true | false)
#   {{skip_final_snapshot}} from cost-tiering.yaml (true | false)
#   {{backup_retention}}    from cost-tiering.yaml
#   {{region}}              AWS region, e.g. us-east-1
#   {{rds_security_group}}  e.g. sg-0abc1234 (copy vpcSecurityGroupIds from another app's
#                          k8s/overlays rds-instance.yaml in the same cluster, or a legacy
#                          crossplane-infra RDS YAML)
#   {{namespace}}           namespace that holds the Password Secret and receives
#                           the Crossplane connection Secret
#   {{management_policies}} YAML inline list from cost-tiering; prod omits Delete
#   {{final_snapshot_identifier_line}} prod: complete four-space-indented YAML line;
#                                      non-prod: leave blank
#
# Rules locked in:
#   1. metadata.annotations.crossplane.io/external-name MUST equal forProvider.identifier
#      (prevents provider observe mismatch against an unrelated RDS instance)
#   2. forProvider.identifier MUST be explicit (not empty)
#   3. spec.deletionPolicy field does NOT exist on m.upbound.io — DO NOT add it.
#      Drift control is via managementPolicies (drop "Delete" for prod).
#   4. For prod: managementPolicies omits "Delete" + deletionProtection=true +
#      skipFinalSnapshot=false (AWS-layer safety net).
#   5. Do NOT add manageMasterUserPassword: true (password to AWS Secrets Manager,
#      breaks PushSecret chain). Workflow uses ESO Password Generator + passwordSecretRef.
#   6. Do NOT add kmsKeyId or kms:CreateGrant permissions. Use AWS-managed key.
#   7. Do NOT add ec2:Describe* IAM perms. crossplane-default subnet + shared SG path.
#   8. Do NOT change this CR's namespace once it manages a live DB. Moving a
#      stateful CR to a new namespace makes ArgoCD CREATE a new CR (re-adopts the
#      DB via external-name) and PRUNE the old one — and the prune DELETES the
#      physical DB unless the old CR's managementPolicies already omits "Delete".
#      Keeping prod orphan-safe (rule #4) is what makes any prune orphan, not
#      delete. validators/check_db_resource_contracts.py enforces rules #3 / #4
#      (no spec.deletionPolicy; prod managementPolicies omits Delete +
#      deletionProtection=true + skipFinalSnapshot=false) and multiAz casing.
#   9. New mysql Instances MUST use the 8.4 LTS contract from
#      references/cost-tiering/rds.yaml -> engine_contracts.mysql. MySQL 8.0 is
#      forbidden. engineVersion, parameterGroupName and optionGroupName must be
#      updated as one unit.

apiVersion: rds.aws.m.upbound.io/v1beta1
kind: Instance
metadata:
  name: {{app}}-{{env_keyword}}-db
  namespace: {{namespace}}
  annotations:
    crossplane.io/external-name: {{app}}-{{env_keyword}}-db
spec:
  managementPolicies: {{management_policies}}
  forProvider:
    identifier: {{app}}-{{env_keyword}}-db
    engine: {{engine}}
    engineVersion: "{{engine_version}}"
{{engine_family_fields}}
    dbName: {{db_name}}
    instanceClass: {{instance_class}}
    allocatedStorage: {{allocated_storage}}
    storageType: gp3
    multiAz: {{multi_az}}
    storageEncrypted: {{storage_encrypted}}
    deletionProtection: {{deletion_protection}}
    skipFinalSnapshot: {{skip_final_snapshot}}
    backupRetentionPeriod: {{backup_retention}}
{{final_snapshot_identifier_line}}
    username: {{username}}
    passwordSecretRef:
      name: {{app}}-rds-password         # generated by ESO Password Generator chain
      key: password
    publiclyAccessible: false            # HARD RED LINE: never true
    dbSubnetGroupName: crossplane-default   # all clusters share this preset
    vpcSecurityGroupIds:
      - {{rds_security_group}}
    region: {{region}}
    tags:
      app: {{app}}
      env: {{env_keyword}}
      managed-by: crossplane
  writeConnectionSecretToRef:
    name: {{app}}-rds-conn               # 7-key Secret consumed by PushSecret
  providerConfigRef:
    name: {{app}}
    kind: ClusterProviderConfig
