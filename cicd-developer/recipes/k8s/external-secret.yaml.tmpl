# ExternalSecret — app reads from Vault into a K8s Secret.
#
# Required slots:
#   {{name}}                   K8s Secret name (e.g. {{app}}-config-secret)
#   {{namespace}}              target namespace (from references/data/env-keywords.yaml)
#   {{cluster_secret_store}}   target cluster CSS from references/data/clusters.yaml -> vault_css
#                              (Sentry DSN is a documented exception; use recipes/sentry/externalsecret.yaml.tmpl)
#   {{refresh_interval}}       default "1h"; use "5m" if rotation is frequent
#   {{vault_remote_key}}       resolver canonical Vault path with leading "secret/" removed;
#                              use this inside each remoteRef.key
#   {{key_mappings}}           1+ entries; one block per K8s secret key
#
# Multi-key example for {{key_mappings}} (inline into the template before writing):
#     - secretKey: DB_HOST
#       remoteRef:
#         key: staging/rds/application/my-app/database
#         property: DB_HOST
#     - secretKey: DB_PORT
#       remoteRef:
#         key: staging/rds/application/my-app/database
#         property: DB_PORT
#
# ⭐ remoteRef.key **不含 `secret/` 前缀** —— A4x fleet ClusterSecretStore 都挂 `path: secret`，
# 这里是相对路径。加 `secret/` 前缀 ESO 会拼成 `secret/secret/...` 双层路径
# → vault 找不到 → ExternalSecret SecretSyncedError "secret does not exist"。
# 跟 `recipes/sentry/externalsecret.yaml.tmpl` 同样的约定。
#
# IMPORTANT: every remoteRef.key MUST be the vault-path resolver canonical
# result with the leading "secret/" removed. Workflow MUST call
# validators/check_vault_paths.py after writing this file.
#
# DO NOT mix the new `external-secrets.io/v1` apiVersion with v1alpha1 in the
# same directory — pick one. v1 is the current default; v1alpha1 only for
# PushSecret (which is still alpha).

apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{name}}
  namespace: {{namespace}}
spec:
  refreshInterval: {{refresh_interval}}
  secretStoreRef:
    name: {{cluster_secret_store}}
    kind: ClusterSecretStore
  target:
    name: {{name}}
    creationPolicy: Owner
  data:
{{key_mappings}}
