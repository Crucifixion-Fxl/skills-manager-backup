# hpa.yaml.tmpl —— Horizontal Pod Autoscaler 模板（CPU 维度）
#
# 默认 v2 metrics-server CPU 扩缩。
#
# 如果要按**业务指标**扩缩（queue depth / qps / Prometheus 自定义 metric / Kafka lag / SQS 等），
# 需要 KEDA ScaledObject —— v2 当前**没有** keda-scaledobject recipe 模板（业务低频需求），
# 触发场景时按下面处理：
#   1. 在应用 overlay 单独写一个 KEDA ScaledObject manifest（参考 https://keda.sh/docs/<version>/scalers/）
#   2. 产 Ops Todo "v2 recipes/k8s/ 待补 keda-scaledobject.yaml.tmpl 通用模板（按 Prometheus / Kafka / SQS 分 scaler 类型）"
# 不要在本模板凭印象编 KEDA YAML。
#
# 必填槽位：
#   {{app}}                 kebab-case；target 必须是 Rollout 或 Deployment
#   {{namespace}}           ns
#   {{min_replicas}}        最少副本数（staging 1，prod 通常 2+）
#   {{max_replicas}}        最大副本数（按峰值流量 + headroom 估）
#   {{target_cpu_percent}}  扩缩触发阈值（典型 70-80）
#
# ⚠️ HPA target Rollout 时 scaleTargetRef.apiVersion 必须用 argoproj.io/v1alpha1，
# 不能用 apps/v1。HPA 不直接 scale Rollout，是修改 Rollout 的 spec.replicas
# 然后由 Rollout controller 调 RS。

apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{app}}
  namespace: {{namespace}}
spec:
  scaleTargetRef:
    apiVersion: argoproj.io/v1alpha1     # Rollout；如果是 Deployment 改 apps/v1
    kind: Rollout                         # 或 Deployment
    name: {{app}}
  minReplicas: {{min_replicas}}
  maxReplicas: {{max_replicas}}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: {{target_cpu_percent}}
  behavior:
    scaleDown:
      stabilizationWindowSeconds: 300    # 5min 防抖
      policies:
        - type: Percent
          value: 50
          periodSeconds: 60
    scaleUp:
      stabilizationWindowSeconds: 0      # 立即扩
      policies:
        - type: Percent
          value: 100
          periodSeconds: 30
        - type: Pods
          value: 4
          periodSeconds: 30
      selectPolicy: Max
