# TKE workload identity; inputs must come from the platform handoff.
# Do not reuse crossplane-system/provider-tencentcloud or its CAM role.
# app: application-specific SA name; namespace: exact target namespace.
# role_arn: dedicated runtime CAM role ARN; audience: verified CAM OIDC client ID.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{app}}
  namespace: {{namespace}}
  annotations:
    tke.cloud.tencent.com/role-arn: "{{role_arn}}"
    tke.cloud.tencent.com/audience: "{{audience}}"
