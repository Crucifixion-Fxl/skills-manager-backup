# Aurora DB ExternalSecret — app reads writer/reader connection fields from Vault.
#
# Required slots:
#   {{app}}                   kebab-case
#   {{namespace}}             target namespace
#   {{cluster_secret_store}}  target cluster CSS from references/data/clusters.yaml -> vault_css
#   {{vault_remote_key}}      resolver canonical Aurora cluster path without leading "secret/"
#                            e.g. prod/aurora/application/my-app/cluster
#
# Ordering:
#   sync-wave "1" keeps this behind the Aurora connection PushSecret
#   (wave "0"). Do not run DB consumers before connection data reaches Vault.

apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{app}}-db-secret
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: {{cluster_secret_store}}
    kind: ClusterSecretStore
  target:
    name: {{app}}-db-secret
    creationPolicy: Owner
  data:
    - secretKey: DB_HOST
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_HOST
    - secretKey: DB_READER_HOST
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_READER_HOST
    - secretKey: DB_PORT
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_PORT
    - secretKey: DB_USER
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_USER
    - secretKey: DB_PASSWORD
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_PASSWORD
