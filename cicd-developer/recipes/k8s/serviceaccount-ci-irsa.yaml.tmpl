# serviceaccount-ci-irsa.yaml.tmpl
#
# GitLab CI Job Pod IRSA K8s side:
# - CI 专用 ServiceAccount，带 IRSA role-arn + GitLab project guard annotations
# - RoleBinding，让 runner SA 能在 CI job namespace 创建 job pod 配套资源
#
# 必填槽位：
#   {{sa_name}}                  ServiceAccount 名，通常 {{app}}-ci-{{purpose}}
#   {{namespace}}                CI job namespace in {phase}-{app}-ci form; must
#                                satisfy the target runner overwrite allow-list
#   {{partition}}                aws | aws-cn
#   {{account_id}}               target AWS account id
#   {{app}}                      kebab-case app name
#   {{purpose}}                  kebab-case purpose
#   {{ci_project_name}}          GitLab CI_PROJECT_NAME（仓库末段，不含 group）
#   {{protected_branch_annotation}}
#                                prod-only 时填：
#                                  ci.gitlab.com/require-protected-branch: "true"
#                                否则留空
#   {{runner_service_account}}   通常 gitlab-runner-amd64；按集群事实覆盖

apiVersion: v1
kind: Namespace
metadata:
  name: {{namespace}}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{sa_name}}
  namespace: {{namespace}}
  annotations:
    eks.amazonaws.com/role-arn: arn:{{partition}}:iam::{{account_id}}:role/crossplane-app-{{app}}-ci-{{purpose}}-irsa
    ci.gitlab.com/allowed-project: {{ci_project_name}}
{{protected_branch_annotation}}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{sa_name}}-runner-job-executor
  namespace: {{namespace}}
subjects:
  - kind: ServiceAccount
    name: {{runner_service_account}}
    namespace: gitlab-runner
roleRef:
  kind: ClusterRole
  name: gitlab-runner-job-executor
  apiGroup: rbac.authorization.k8s.io
