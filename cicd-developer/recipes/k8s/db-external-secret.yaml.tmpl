# DB ExternalSecret — app reads database connection fields from Vault.
#
# Required slots:
#   {{app}}                   kebab-case
#   {{namespace}}             target namespace
#   {{cluster_secret_store}}  target cluster CSS from references/data/clusters.yaml -> vault_css
#   {{vault_remote_key}}      resolver canonical database path without leading "secret/"
#                            e.g. staging/rds/application/my-app/database
#
# Ordering:
#   sync-wave "1" keeps this behind the Crossplane connection PushSecret
#   (wave "0"). It prevents ArgoCD from running DB consumers before the
#   platform connection data has reached Vault.
#
# remoteRef.key MUST NOT include the leading "secret/" prefix because fleet
# ClusterSecretStore objects already mount path=secret.

apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{app}}-db-secret
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: {{cluster_secret_store}}
    kind: ClusterSecretStore
  target:
    name: {{app}}-db-secret
    creationPolicy: Owner
  data:
    - secretKey: DB_HOST
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_HOST
    - secretKey: DB_PORT
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_PORT
    - secretKey: DB_USER
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_USER
    - secretKey: DB_PASSWORD
      remoteRef:
        key: {{vault_remote_key}}
        property: DB_PASSWORD
