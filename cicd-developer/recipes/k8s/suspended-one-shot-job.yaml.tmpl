# suspended-one-shot-job.yaml.tmpl
#
# GitOps registration template for a finite, side-effecting Job. Registration
# must not execute work: keep suspend=true and execution-approval=pending.
# A separately approved execution MR changes only those two fields. Do not add
# an Argo CD hook or ttlSecondsAfterFinished; either can create implicit or
# repeated execution semantics.
#
# Required slots:
#   {{one_shot_job_name}}       unique immutable Job name
#   {{namespace}}               existing owning Application namespace
#   {{app}}                     app label used by logging
#   {{env_keyword}}             environment label
#   {{sync_wave}}               registration ordering after prerequisites
#   {{active_deadline_seconds}} finite deadline
#   {{service_account_name}}    default unless reviewed cloud identity is required
#   {{node_selector_block}}     complete pod-spec nodeSelector block
#   {{run_as_user}}             non-root UID supported by the image
#   {{one_shot_image}}          internal Harbor image with fixed tag/digest
#   {{script_file_name}}        ConfigMap-projected reviewed script
#   {{envfrom_block}}           complete envFrom list
#   {{env_block}}               complete env list
#   {{cpu_requests}}, {{memory_requests}}, {{ephemeral_storage_requests}}
#   {{cpu_limits}}, {{memory_limits}}, {{ephemeral_storage_limits}}
#   {{script_config_map_name}}  app-scoped generated ConfigMap
#   {{work_size_limit}}         bounded scratch archive/work volume
#   {{temp_size_limit}}         bounded /tmp volume

apiVersion: batch/v1
kind: Job
metadata:
  name: {{one_shot_job_name}}
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "{{sync_wave}}"
    ops.addx.io/execution-approval: pending
  labels:
    app: {{app}}
    app.kubernetes.io/name: {{app}}
    app.kubernetes.io/component: one-shot-job
spec:
  suspend: true
  completions: 1
  parallelism: 1
  backoffLimit: 0
  activeDeadlineSeconds: {{active_deadline_seconds}}
  template:
    metadata:
      labels:
        app: {{app}}
        env: {{env_keyword}}
        app.kubernetes.io/name: {{app}}
        app.kubernetes.io/component: one-shot-job
    spec:
      automountServiceAccountToken: false
      serviceAccountName: {{service_account_name}}
      restartPolicy: Never
      terminationGracePeriodSeconds: 30
{{node_selector_block}}
      imagePullSecrets:
        - name: harbor-registry-secret
      securityContext:
        runAsNonRoot: true
        runAsUser: {{run_as_user}}
        runAsGroup: {{run_as_user}}
        fsGroup: {{run_as_user}}
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: run
          image: {{one_shot_image}}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - /opt/one-shot/{{script_file_name}}
          envFrom:
{{envfrom_block}}
          env:
{{env_block}}
          resources:
            requests:
              cpu: {{cpu_requests}}
              memory: {{memory_requests}}
              ephemeral-storage: {{ephemeral_storage_requests}}
            limits:
              cpu: {{cpu_limits}}
              memory: {{memory_limits}}
              ephemeral-storage: {{ephemeral_storage_limits}}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: script
              mountPath: /opt/one-shot
              readOnly: true
            - name: work
              mountPath: /work
            - name: temp
              mountPath: /tmp
      volumes:
        - name: script
          configMap:
            name: {{script_config_map_name}}
            defaultMode: 0555
        - name: work
          emptyDir:
            sizeLimit: {{work_size_limit}}
        - name: temp
          emptyDir:
            sizeLimit: {{temp_size_limit}}
