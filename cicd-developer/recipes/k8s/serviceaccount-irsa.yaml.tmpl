# serviceaccount-irsa.yaml.tmpl
#
# K8s ServiceAccount，绑定 IRSA Role 让 Pod 用 OIDC token 换 AWS 凭证。
#
# 配套：必须先有 crossplane-irsa-role.yaml.tmpl 创建的 Role + rolepolicy。
#
# 必填槽位：
#   {{app}}            kebab-case；ServiceAccount 名通常 = {{app}}
#   {{namespace}}      Pod 跑的 namespace
#   {{partition}}      aws | aws-cn
#   {{account_id}}     目标集群的 AWS account id
#
# Pod template 引用此 SA：spec.serviceAccountName: {{app}}（默认 SA 不挂 IRSA）。

apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{app}}
  namespace: {{namespace}}
  annotations:
    eks.amazonaws.com/role-arn: arn:{{partition}}:iam::{{account_id}}:role/crossplane-app-{{app}}-irsa
