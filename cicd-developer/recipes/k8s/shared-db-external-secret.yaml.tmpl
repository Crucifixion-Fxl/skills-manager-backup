# Shared Database ExternalSecret — map the Composition's lower-case Vault
# fields into conventional application DB_* Secret keys.
#
# Required slots:
#   {{consumer_secret_name}}  explicit ExternalSecret and target Secret name;
#                             preserve an existing primary name (usually <app>-db-secret).
#                             Secondary postgres: <app>-postgres-<purpose-dns>-db-secret.
#                             This consumer name never changes claim spec.app or Vault owner.
#   {{namespace}}             target namespace
#   {{cluster_secret_store}}  target cluster CSS from clusters.yaml
#   {{vault_remote_key}}      shared Database path without leading secret/
#
# The shared SQL kind:Database Composition publishes host/port/username/password.
# Redis publishes only host/port; use external-secret.yaml.tmpl for that branch.
# Do not use the app-owned RDS template here; that producer publishes upper-case
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD instead.

apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{consumer_secret_name}}
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "1"
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: {{cluster_secret_store}}
    kind: ClusterSecretStore
  target:
    name: {{consumer_secret_name}}
    creationPolicy: Owner
  data:
    - secretKey: DB_HOST
      remoteRef:
        key: {{vault_remote_key}}
        property: host
    - secretKey: DB_PORT
      remoteRef:
        key: {{vault_remote_key}}
        property: port
    - secretKey: DB_USER
      remoteRef:
        key: {{vault_remote_key}}
        property: username
    - secretKey: DB_PASSWORD
      remoteRef:
        key: {{vault_remote_key}}
        property: password
