# serviceaccount.yaml.tmpl
#
# Plain workload ServiceAccount for targets that do not use AWS IRSA.
# Use serviceaccount-irsa.yaml.tmpl only when the target is AWS and the Pod
# needs the corresponding workload IAM role.
#
# Required slots:
#   {{app}}        kebab-case ServiceAccount name
#   {{namespace}}  target namespace

apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{app}}
  namespace: {{namespace}}
