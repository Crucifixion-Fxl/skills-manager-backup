# clickhouse-password-generator.yaml.tmpl
#
# Generate the ClickHouse default-user password once for this StatefulSet.
# The matching ExternalSecret consumes its password key and creates
# {{app}}-clickhouse-secret for the workload.

apiVersion: generators.external-secrets.io/v1alpha1
kind: Password
metadata:
  name: {{app}}-clickhouse-password-gen
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "-5"
spec:
  length: 24
  digits: 5
  symbols: 0
  symbolCharacters: ""
  noUpper: false
  allowRepeat: true
