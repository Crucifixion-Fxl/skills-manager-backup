# clickhouse-password-external-secret.yaml.tmpl
#
# Materialize the generated password key as the Secret consumed by the
# ClickHouse StatefulSet. Do not delete and recreate this ExternalSecret:
# generator-backed reconciliation can replace the existing password.

apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{app}}-clickhouse-secret
  namespace: {{namespace}}
  annotations:
    argocd.argoproj.io/sync-wave: "-4"
spec:
  refreshInterval: 0s
  target:
    name: {{app}}-clickhouse-secret
    creationPolicy: Owner
    deletionPolicy: Retain
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: {{app}}-clickhouse-password-gen
