# sentry-externalsecret.yaml.tmpl
#
# ExternalSecret 把 Vault 里的 Sentry DSN 渲染成 K8s Secret `{{app}}-sentry-dsn`，
# Pod env 通过 secretKeyRef 拉 `dsn` key。
#
# 必填槽位：
#   {{app}}                  kebab-case（vault 路径 app 段）
#   {{env}}                  dev | staging | pre | prod（vault 路径 env 段）
#   {{namespace}}            ns
#   {{cluster_secret_store}} 读 Sentry DSN 的 ClusterSecretStore 名字
#
# ⭐ 这个 CSS 必须指向 sentry-onboard Job 写入 DSN 的同一个 Vault 实例。
# 不要直接套用目标集群默认 `vault_css`，也不要按 `vault-backend` 名字猜 Vault 域。
# Sentry DSN 必须从 `references/sentry/README.md -> SENTRY_DSN_CSS` 取，
# 确保 ExternalSecret 读取 sentry-onboard Job 写入的同一个 Vault 实例。
#
# ⭐ remoteRef.key **不含 `secret/` 前缀** —— CSS 已挂 `path: secret`，这里是相对路径。
# 加前缀会报 "Secret does not exist"（常见错误）。
#
# ⭐ key 路径 schema 必须跟 ConfigMap.VAULT_PATH_SCHEMA 一致：
#   ConfigMap=platform（新接入）→ key: {env}/sentry/application/{app}/project
#   ConfigMap=legacy（老应用）  → key: {env}/app/{app}/sentry-dsn
# 两端不一致 = Job 写新路径 ES 拉旧路径 = `{{app}}-sentry-dsn` Secret 永远空。
#
# refreshInterval=1m：Job 写完 Vault 后 Pod 1 分钟内能拿到 DSN（Job 跑完 → ES 下次 refresh → K8s Secret 更新 → Pod env 重新挂载）。

apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{app}}-sentry-dsn
  namespace: {{namespace}}
spec:
  refreshInterval: 1m
  secretStoreRef:
    name: {{cluster_secret_store}}
    kind: ClusterSecretStore
  target:
    name: {{app}}-sentry-dsn
    creationPolicy: Owner
  data:
    - secretKey: dsn
      remoteRef:
        key: {{env}}/sentry/application/{{app}}/project   # platform schema（新接入强制）
        property: dsn
