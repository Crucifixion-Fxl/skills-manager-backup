# per-target dual-arch snippet
#
# 用于 EKS 等 dual-arch（amd64 + arm64）集群。Per target 渲染 3 个 job：
#   build:{{target_key}}:amd64  —— amd64 runner kaniko build push 到该 target 的 harbor
#   build:{{target_key}}:arm64  —— arm64 runner kaniko build push 到该 target 的 harbor
#   manifest:{{target_key}}     —— crane 合并两 arch 成 multi-arch manifest index
#
# 必填槽位：
#   {{target_key}}              env_keyword 或 cluster shortname（CI job 名前缀 + 区分用）
#                               e.g. staging-us / prod-eu / prod-us-restricted-admin
#   {{harbor_image_path}}       该 target 的业务镜像 push 路径，两种写法（见 hard-rules #25）：
#                               - B 默认（runner 决定 host）：${IMAGE_BASE}/<env>-<region>/<app>
#                                 IMAGE_BASE=${HARBOR_REGISTRY}/cicd，host 由 runner tag 决定
#                               - A（字面 host，单 target / grandfather）：
#                                 harbor-39070-us-staging.addx.live/cicd/staging-us/<app>
#                               解析出的 host MUST match overlay newName + Application image-list
#                               （部署侧永远是字面 host，不展开 ${IMAGE_BASE}）。
#   {{runner_tag_amd64}}        该 target 集群对应 amd64 runner tag
#                               来源 clusters.yaml 的 runner_tags[0]
#   {{runner_tag_arm64}}        该 target 集群对应 arm64 runner tag
#                               来源 clusters.yaml 的 runner_tags[1]
#   {{branch}}                  CI 触发分支（main / prod / staging / pre / dev / master）
#   {{dockerfile_path}}         service profile 用 Dockerfile；static-web profile
#                               用该 target 专属 Dockerfile.<env-keyword>
# Image tags:
#   - arch build jobs push intermediate tags `${CI_COMMIT_SHORT_SHA}-amd64|arm64`
#   - manifest job pushes final tag `${CI_COMMIT_SHORT_SHA}`
#   - final tag MUST match the Application's `allow-tags: regexp:^[a-f0-9]{7,40}$`
#     so ArgoCD Image Updater can select it. Env separation lives in IMAGE_PATH
#     (`cicd/<env>-<region>/<app>`), not in the tag string.
#
# 同一应用多 target 时，本 snippet **追加多次**（每 target 一份），所有 target 共享上面的 shell
# (stages / APP_NAME / hidden job primitives)。

build:{{target_key}}:amd64:
  extends: .kaniko-build
  tags:
    - {{runner_tag_amd64}}
  variables:
    IMAGE_PATH: {{harbor_image_path}}
    ARCH: amd64
    DOCKERFILE: {{dockerfile_path}}
  rules:
    - if: $CI_COMMIT_BRANCH == "{{branch}}"
      variables:
        IMAGE_TAG: ${CI_COMMIT_SHORT_SHA}-amd64

build:{{target_key}}:arm64:
  extends: .kaniko-build
  tags:
    - {{runner_tag_arm64}}
  variables:
    IMAGE_PATH: {{harbor_image_path}}
    ARCH: arm64
    DOCKERFILE: {{dockerfile_path}}
  rules:
    - if: $CI_COMMIT_BRANCH == "{{branch}}"
      variables:
        IMAGE_TAG: ${CI_COMMIT_SHORT_SHA}-arm64

manifest:{{target_key}}:
  extends: .manifest-fanin
  stage: manifest
  needs:
    - build:{{target_key}}:amd64
    - build:{{target_key}}:arm64
  tags:
    - {{runner_tag_amd64}}
  variables:
    IMAGE_PATH: {{harbor_image_path}}
  rules:
    - if: $CI_COMMIT_BRANCH == "{{branch}}"
      variables:
        SOURCE_AMD64_TAG: ${CI_COMMIT_SHORT_SHA}-amd64
        SOURCE_ARM64_TAG: ${CI_COMMIT_SHORT_SHA}-arm64
        TARGET_TAG: ${CI_COMMIT_SHORT_SHA}
