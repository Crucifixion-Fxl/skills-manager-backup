        },
        "port": "8480",
        "replicaCount": 2,
        "resources": {
          "limits": {
            "cpu": "1",
            "memory": "2Gi"
          },
          "requests": {
            "cpu": "500m",
            "memory": "1Gi"
          }
        }
      },
      "vmselect": {
        "affinity": {
          "podAntiAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": [
              {
                "labelSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/component": "server",
                    "app.kubernetes.io/name": "prometheus"
                  }
                },
                "namespaces": [
                  "prometheus"
                ],
                "topologyKey": "kubernetes.io/hostname"
              },
              {
                "labelSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "thanos-store"
                  }
                },
                "namespaces": [
                  "prometheus"
                ],
                "topologyKey": "kubernetes.io/hostname"
              },
              {
                "labelSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "thanos-query"
                  }
                },
                "namespaces": [
                  "prometheus"
                ],
                "topologyKey": "kubernetes.io/hostname"
              },
              {
                "labelSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/instance": "victoria-metrics",
                    "app.kubernetes.io/name": "vmselect"
                  }
                },
                "topologyKey": "kubernetes.io/hostname"
              }
            ]
          }
        },
        "cacheMountPath": "/select-cache",
        "extraArgs": {
          "search.denyPartialResponse": "true",
          "vmalert.proxyURL": "http://vmalert-victoria-metrics.victoria-metrics.svc.cluster.local.:8080"
        },
        "nodeSelector": {
          "node-group": "prometheus"
        },
        "port": "8481",
        "replicaCount": 2,
        "resources": {
          "limits": {
            "cpu": "1",
            "memory": "2Gi"
          },
          "requests": {
            "cpu": "200m",
            "memory": "512Mi"
          }
        },
        "storage": {
          "volumeClaimTemplate": {
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "10Gi"
                }
              },
              "storageClassName": "gp3"
            }
          }
        }
      },
      "vmstorage": {
        "affinity": {
          "podAntiAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": [
              {
                "labelSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/component": "server",
                    "app.kubernetes.io/name": "prometheus"
                  }
                },
                "namespaces": [
                  "prometheus"
                ],
                "topologyKey": "kubernetes.io/hostname"
              },
              {
                "labelSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "thanos-store"
                  }
                },
                "namespaces": [
                  "prometheus"
                ],
                "topologyKey": "kubernetes.io/hostname"
              },
              {
                "labelSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "thanos-query"
                  }
                },
                "namespaces": [
                  "prometheus"
                ],
                "topologyKey": "kubernetes.io/hostname"
              },
              {
                "labelSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/instance": "victoria-metrics",
                    "app.kubernetes.io/name": "vmstorage"
                  }
                },
                "topologyKey": "kubernetes.io/hostname"
              }
            ]
          }
        },
        "nodeSelector": {
          "node-group": "prometheus",
          "node.kubernetes.io/instance-type": "m7g.xlarge"
        },
        "replicaCount": 3,
        "resources": {
          "limits": {
            "cpu": "2",
            "memory": "12Gi"
          },
          "requests": {
            "cpu": "1",
            "memory": "6Gi"
          }
        },
        "storage": {
          "volumeClaimTemplate": {
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "300Gi"
                }
              },
              "storageClassName": "gp3"
            }
          }
        },
        "storageDataPath": "/vm-data"
      }
    }
