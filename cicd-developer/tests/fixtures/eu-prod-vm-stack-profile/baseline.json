      },
      "scrapeInterval": "30s",
      "selectAllByDefault": false,
      "serviceScrapeSelector": {
        "matchLabels": {
          "monitoring.addx.io/scrape-plane": "nat-egress"
        }
      },
      "staticScrapeSelector": {
        "matchLabels": {
          "monitoring.addx.io/scrape-plane": "nat-egress"
        }
      }
    }
  },
