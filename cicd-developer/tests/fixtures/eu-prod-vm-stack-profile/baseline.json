        "matchLabels": {
          "monitoring.addx.io/scrape-plane": "nat-egress"
        }
      },
      "probeSelector": {
        "matchLabels": {
          "monitoring.addx.io/scrape-plane": "nat-egress"
        }
      },
      "remoteWrite": [
        {
          "url": "http://vminsert-victoria-metrics.victoria-metrics.svc.cluster.local.:8480/insert/0/prometheus/api/v1/write"
        }
      ],
