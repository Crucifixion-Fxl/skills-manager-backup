#!/usr/bin/env python3
"""Entry point: harness-failover <detect|switch|retry|learn|profiles> ..."""
import os
import sys

# The installed copy is code a timer executes every 5 minutes: never write bytecode next to it (Python would create
# the __pycache__ with the caller's umask, e.g. group-writable under systemd's default 0002).
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(os.path.realpath(__file__))))

from harness_failover.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
